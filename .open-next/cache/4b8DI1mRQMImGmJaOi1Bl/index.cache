<!-- -->180<small>/night</small></span></div><a class=\"Button-module-scss-module__VUJcyW__button Button-module-scss-module__VUJcyW__primary Button-module-scss-module__VUJcyW__sm\" href=\"/hotels/hotel-4/book\"><span>Book Now</span></a></div></div></div></div></div><div class=\"HotelsSection-module-scss-module__6AhQNW__viewAll\"><a class=\"Button-module-scss-module__VUJcyW__button Button-module-scss-module__VUJcyW__outline Button-module-scss-module__VUJcyW__md\" href=\"/hotels\"><span>Explore More Hotels</span><span class=\"Button-module-scss-module__VUJcyW__icon\"><img alt=\"\" loading=\"lazy\" width=\"16\" height=\"16\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent;margin-top:2px\" src=\"/images/arrows/arrow-right-blue.svg\"/></span></a></div></div></section><section class=\"DesertSection-module-scss-module__sbTr2a__section\"><div class=\"DesertSection-module-scss-module__sbTr2a__container\"><div class=\"SectionHeader-module-scss-module__J6xJhW__header SectionHeader-module-scss-module__J6xJhW__center\"><span class=\"SectionHeader-module-scss-module__J6xJhW__label\"><img alt=\"Trips\" loading=\"lazy\" width=\"18\" height=\"18\" decoding=\"async\" data-nimg=\"1\" class=\"SectionHeader-module-scss-module__J6xJhW__labelIcon\" style=\"color:transparent\" src=\"/images/trips2.svg\"/>Desert</span><h2 class=\"SectionHeader-module-scss-module__J6xJhW__heading  \">Reveal Egypt&#x27;s Desert</h2><p class=\"SectionHeader-module-scss-module__J6xJhW__description\" style=\"max-width:830px\">Journey into the heart of the Egyptian wilderness with unmatched elegance. From nomadic festivals to luxury desert retreats, we provide the ultimate VIP passage to Egypt&#x27;s most hidden gems</p></div><div class=\"DesertSection-module-scss-module__sbTr2a__cardsWrapper\"><div class=\"DesertSection-module-scss-module__sbTr2a__cards\"><a href=\"#\" class=\"DestinationCard-module-scss-module__D4OXaq__card\"><div class=\"DestinationCard-module-scss-module__D4OXaq__imageWrap\"><img alt=\"Western Desert\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"DestinationCard-module-scss-module__D4OXaq__image\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/desert/western.png\"/><div class=\"DestinationCard-module-scss-module__D4OXaq__overlay\"></div></div><span class=\"DestinationCard-module-scss-module__D4OXaq__arrow\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M7 7h8.586L5.293 17.293l1.414 1.414L17 8.414V17h2V5H7v2z\"></path></svg></span><div class=\"DestinationCard-module-scss-module__D4OXaq__content\"><h3 class=\"DestinationCard-module-scss-module__D4OXaq__title\">Western Desert</h3><p class=\"DestinationCard-module-scss-module__D4OXaq__description\">Experience the thrill of the Egyptian desert with camel rides and sandboarding adventures.</p><span class=\"DestinationCard-module-scss-module__D4OXaq__cta\">Explore more<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z\"></path></svg></span></div></a><a href=\"#\" class=\"DestinationCard-module-scss-module__D4OXaq__card\"><div class=\"DestinationCard-module-scss-module__D4OXaq__imageWrap\"><img alt=\"Sinai Desert\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"DestinationCard-module-scss-module__D4OXaq__image\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/desert/sinai.png\"/><div class=\"DestinationCard-module-scss-module__D4OXaq__overlay\"></div></div><span class=\"DestinationCard-module-scss-module__D4OXaq__arrow\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M7 7h8.586L5.293 17.293l1.414 1.414L17 8.414V17h2V5H7v2z\"></path></svg></span><div class=\"DestinationCard-module-scss-module__D4OXaq__content\"><h3 class=\"DestinationCard-module-scss-module__D4OXaq__title\">Sinai Desert</h3><p class=\"DestinationCard-module-scss-module__D4OXaq__description\">Experience the thrill of the Egyptian desert with camel rides and sandboarding adventures.</p><span class=\"DestinationCard-module-scss-module__D4OXaq__cta\">Explore more<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z\"></path></svg></span></div></a><a href=\"#\" class=\"DestinationCard-module-scss-module__D4OXaq__card\"><div class=\"DestinationCard-module-scss-module__D4OXaq__imageWrap\"><img alt=\"Oasis Desert\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"DestinationCard-module-scss-module__D4OXaq__image\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/desert/oasis.jpg\"/><div class=\"DestinationCard-module-scss-module__D4OXaq__overlay\"></div></div><span class=\"DestinationCard-module-scss-module__D4OXaq__arrow\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M7 7h8.586L5.293 17.293l1.414 1.414L17 8.414V17h2V5H7v2z\"></path></svg></span><div class=\"DestinationCard-module-scss-module__D4OXaq__content\"><h3 class=\"DestinationCard-module-scss-module__D4OXaq__title\">Oasis Desert</h3><p class=\"DestinationCard-module-scss-module__D4OXaq__description\">Experience the thrill of the Egyptian desert with camel rides and sandboarding adventures.</p><span class=\"DestinationCard-module-scss-module__D4OXaq__cta\">Explore more<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z\"></path></svg></span></div></a><a href=\"#\" class=\"DestinationCard-module-scss-module__D4OXaq__card\"><div class=\"DestinationCard-module-scss-module__D4OXaq__imageWrap\"><img alt=\"Safari Trips\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"DestinationCard-module-scss-module__D4OXaq__image\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/desert/safari.jpg\"/><div class=\"DestinationCard-module-scss-module__D4OXaq__overlay\"></div></div><span class=\"DestinationCard-module-scss-module__D4OXaq__arrow\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M7 7h8.586L5.293 17.293l1.414 1.414L17 8.414V17h2V5H7v2z\"></path></svg></span><div class=\"DestinationCard-module-scss-module__D4OXaq__content\"><h3 class=\"DestinationCard-module-scss-module__D4OXaq__title\">Safari Trips</h3><p class=\"DestinationCard-module-scss-module__D4OXaq__description\">Experience the thrill of the Egyptian desert with camel rides and sandboarding adventures.</p><span class=\"DestinationCard-module-scss-module__D4OXaq__cta\">Explore more<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z\"></path></svg></span></div></a></div></div></div></section><section class=\"MiceSection-module-scss-module__dZufBW__section\"><div class=\"MiceSection-module-scss-module__dZufBW__container\"><div class=\"SectionHeader-module-scss-module__J6xJhW__header SectionHeader-module-scss-module__J6xJhW__center\"><span class=\"SectionHeader-module-scss-module__J6xJhW__label\"><img alt=\"Trips\" loading=\"lazy\" width=\"18\" height=\"18\" decoding=\"async\" data-nimg=\"1\" class=\"SectionHeader-module-scss-module__J6xJhW__labelIcon\" style=\"color:transparent\" src=\"/images/trips2.svg\"/>MICE &amp; Corporate Events</span><h2 class=\"SectionHeader-module-scss-module__J6xJhW__heading  \">Host World-Class Business Events in Egypt</h2><p class=\"SectionHeader-module-scss-module__J6xJhW__description\">High-level meetings, curated incentives, and world-class exhibitions tailored for leading organizations.</p></div><div class=\"MiceSection-module-scss-module__dZufBW__features\"><div class=\"FeatureCard-module-scss-module__6Lyx7a__card\" style=\"background-color:#2563EB10;border-color:#2563EB26\"><div class=\"FeatureCard-module-scss-module__6Lyx7a__iconWrapper\" style=\"background-color:#2563EB10;color:#2563EB\"><img alt=\"\" loading=\"lazy\" width=\"28\" height=\"28\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/mice/meetings.svg\"/></div><h3 class=\"FeatureCard-module-scss-module__6Lyx7a__title\">Meetings</h3><p class=\"FeatureCard-module-scss-module__6Lyx7a__description\">Executive boardrooms and strategic gatherings</p></div><div class=\"FeatureCard-module-scss-module__6Lyx7a__card\" style=\"background-color:#EF444410;border-color:#EF444426\"><div class=\"FeatureCard-module-scss-module__6Lyx7a__iconWrapper\" style=\"background-color:#EF444410;color:#EF4444\"><img alt=\"\" loading=\"lazy\" width=\"28\" height=\"28\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/mice/incentives.svg\"/></div><h3 class=\"FeatureCard-module-scss-module__6Lyx7a__title\">Incentives</h3><p class=\"FeatureCard-module-scss-module__6Lyx7a__description\">Luxury reward trips and curated team experiences</p></div><div class=\"FeatureCard-module-scss-module__6Lyx7a__card\" style=\"background-color:#10B98110;border-color:#10B98126\"><div class=\"FeatureCard-module-scss-module__6Lyx7a__iconWrapper\" style=\"background-color:#10B98110;color:#10B981\"><img alt=\"\" loading=\"lazy\" width=\"28\" height=\"28\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/mice/conferences.svg\"/></div><h3 class=\"FeatureCard-module-scss-module__6Lyx7a__title\">Conferences</h3><p class=\"FeatureCard-module-scss-module__6Lyx7a__description\">Large-scale conferences with full technical support</p></div><div class=\"FeatureCard-module-scss-module__6Lyx7a__card\" style=\"background-color:#8B5CF610;border-color:#8B5CF626\"><div class=\"FeatureCard-module-scss-module__6Lyx7a__iconWrapper\" style=\"background-color:#8B5CF610;color:#8B5CF6\"><im