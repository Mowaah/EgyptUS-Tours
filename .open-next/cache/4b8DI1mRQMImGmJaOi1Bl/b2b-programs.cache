rl=%2Fimages%2Fb2bpage%2Fb2b4.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b4.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fb2bpage%2Fb2b4.jpg&amp;w=3840&amp;q=75\"/></button><button class=\"DetailGallery-module-scss-module__UBN3la__thumb \"><img alt=\"Corporate Travel Experiences Photo 5\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"DetailGallery-module-scss-module__UBN3la__thumbImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"120px\" srcSet=\"/_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=128&amp;q=75 128w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fb2bpage%2Fb2b5.jpg&amp;w=3840&amp;q=75\"/></button></div></div></div></div><div class=\"B2BProgramsPage-module-scss-module__Q8r_PW__container\"><div class=\"B2BProgramsPage-module-scss-module__Q8r_PW__withSidebar\"><div class=\"B2BProgramsPage-module-scss-module__Q8r_PW__mainContent\"><section id=\"overview\" class=\"B2BOverview-module-scss-module__DxVvPG__section\"><div class=\"B2BOverview-module-scss-module__DxVvPG__content\"><h2 class=\"B2BOverview-module-scss-module__DxVvPG__title\">Overview</h2><div class=\"B2BOverview-module-scss-module__DxVvPG__descriptionWrap\"><p class=\"B2BOverview-module-scss-module__DxVvPG__description\">Our B2B division is dedicated to building long-term partnerships with companies seeking reliable, results-driven corporate event and travel solutions.</p><p class=\"B2BOverview-module-scss-module__DxVvPG__description\">We work closely with decision-makers, HR leaders, and event managers to deliver seamless MICE experiences â€” from executive meetings and conferences to incentive retreats and large-scale corporate events.</p><p class=\"B2BOverview-module-scss-module__DxVvPG__description\">With a structured process, transparent pricing, and full operational support, we position ourselves not just as a service provider, but as a trusted corporate event partner.</p></div></div></section></div><div class=\"B2BProgramsPage-module-scss-module__Q8r_PW__bookingSidebar\"><aside class=\"B2BBookingWidget-module-scss-module__czHKZq__sidebar\" aria-label=\"Request a B2B proposal\"><div class=\"B2BBookingWidget-module-scss-module__czHKZq__card\"><div class=\"B2BBookingWidget-module-scss-module__czHKZq__desktop\"><div class=\"B2BBookingWidget-module-scss-module__czHKZq__headerContent\"><div class=\"B2BBookingWidget-module-scss-module__czHKZq__textWrapper\"><h3 class=\"B2BBookingWidget-module-scss-module__czHKZq__title\">Your Trusted B2B Corporate Partner</h3><p class=\"B2BBookingWidget-module-scss-module__czHKZq__description\">Submit your request and our B2B team will prepare a tailored proposal for your company.</p></div></div><div class=\"B2BBookingWidget-module-scss-module__czHKZq__divider\"></div><div class=\"B2BBookingWidget-module-scss-module__czHKZq__actions\"><div class=\"B2BBookingWidget-module-scss-module__czHKZq__actionsContent\"><a class=\"Button-module-scss-module__VUJcyW__button Button-module-scss-module__VUJcyW__primary Button-module-scss-module__VUJcyW__lg B2BBookingWidget-module-scss-module__czHKZq__primaryBtn\" href=\"/b2b-programs/request-proposal\"><span>Request Proposal</span><span class=\"Button-module-scss-module__VUJcyW__icon\"><img alt=\"\" loading=\"lazy\" width=\"24\" height=\"24\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent;filter:brightness(0) invert(1)\" src=\"/images/arrows/arrow-right.svg\"/></span></a></div></div></div><div class=\"B2BBookingWidget-module-scss-module__czHKZq__mobile\"><a class=\"B2BBookingWidget-module-scss-module__czHKZq__cta\" href=\"/b2b-programs/request-proposal\">Request Proposal<img alt=\"\" loading=\"lazy\" width=\"24\" height=\"24\" decoding=\"async\" data-nimg=\"1\" class=\"B2BBookingWidget-module-scss-module__czHKZq__ctaIcon\" style=\"color:transparent\" src=\"/images/arrows/arrow-right.svg\"/></a></div></div></aside></div></div><section id=\"features\" class=\"B2BFeatures-module-scss-module__JqrkjG__section\"><div class=\"B2BFeatures-module-scss-module__JqrkjG__header\"><h2 class=\"B2BFeatures-module-scss-module__JqrkjG__title\">What We Offer</h2><p class=\"B2BFeatures-module-scss-module__JqrkjG__subtitle\">High-level meetings, curated incentives, and world-class exhibitions tailored<br/>for leading organizations.</p></div><div class=\"B2BFeatures-module-scss-module__JqrkjG__features\"><div class=\"FeatureCard-module-scss-module__6Lyx7a__card\" style=\"background-color:#F8FCFF;border-color:#EAF1FD\"><div class=\"FeatureCard-module-scss-module__6Lyx7a__iconWrapper\" style=\"background-color:#EAF6FF;color:#2563EB\"><img alt=\"\" loading=\"lazy\" width=\"28\" height=\"28\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/mice/meetings.svg\"/></div><h3 class=\"FeatureCard-module-scss-module__6Lyx7a__title\">Corporate Retreats</h3><p class=\"FeatureCard-module-scss-module__6Lyx7a__description\">Leadership &amp; strategy-focused escapes.</p></div><div class=\"FeatureCard-module-scss-module__6Lyx7a__card\" style=\"background-color:rgba(255, 240, 230, 0.22);border-color:#FFF1E8\"><div class=\"FeatureCard-module-scss-module__6Lyx7a__iconWrapper\" style=\"background-color:#FFF0E6;color:#2563EB\"><img alt=\"\" loading=\"lazy\" width=\"28\" height=\"28\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/mice/incentives.svg\"/></div><h3 class=\"FeatureCard-module-scss-module__6Lyx7a__title\">Team Building Programs</h3><p class=\"FeatureCard-module-scss-module__6Lyx7a__description\">Engaging activities that strengthen teams.</p></div><div class=\"FeatureCard-module-scss-module__6Lyx7a__card\" style=\"background-color:rgba(240, 253, 244, 0.28);border-color:#EDFBF3\"><div class=\"FeatureCard-module-scss-module__6Lyx7a__iconWrapper\" style=\"background-color:#F0FDF4;color:#2563EB\"><img alt=\"\" loading=\"lazy\" width=\"28\" height=\"28\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/mice/conferences.svg\"/></div><h3 class=\"FeatureCard-module-scss-module__6Lyx7a__title\">Corporate Events</h3><p class=\"FeatureCard-module-scss-module__6Lyx7a__description\">Gala dinners, company celebrations, award nights.</p></div><div class=\"FeatureCard-module-scss-module__6Lyx7a__card\" style=\"background-color:rgba(223, 234, 251, 0.17);border-color:#EAF1FD\"><div class=\"FeatureCard-module-scss-module__6Lyx7a__iconWrapper\" style=\"background-color:#DFEAFB;color:#2563EB\"><img alt=\"\" loading=\"lazy\" width=\"28\" height=\"28\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/mice/exhibitions.svg\"/></div><h3 class=\"FeatureCard-module-scss-module__6Lyx7a__title\">Incentive Travel</h3><p class=\"FeatureCard-module-scss-module__6Lyx7a__description\">Reward top performers in unforgettable destinations.</p></div></div></section><section class=\"ProcessTimeline-module-scss-module___J1vsW__section ProcessTimeline-module-scss-module___J1vsW__padding-normal\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__header\"><h2 class=\"ProcessTimeline-module-scss-module___J1vsW__title\">Our Proven Corporate Process</h2><p class=\"ProcessTimeline-module-scss-module___J1vsW__subtitle\">A systematic approach that ensures every corporate event exceeds expectations.</p></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__timelineContainer\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__lineBase\"></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__lineProgress \" style=\"--active-ratio:1\"></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__steps\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__stepItem\" style=\"--activate-delay:350ms;--vline-activate-delay:1050ms\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__stepAside\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__circle  \"><span class=\"ProcessTimeline-module-scss-module___J1vsW__number\">01</span></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__vLine \" aria-hidden=\"true\"></div></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__content\"><h3 class=\"ProcessTimeline-module-scss-module___J1vsW__stepTitle\">Understand Your Objectives</h3><p class=\"ProcessTimeline-module-scss-module___J1vsW__stepDescription\">We start by learning about your goals, audience, and expectations.</p></div></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__stepItem\" style=\"--activate-delay:1050ms;--vline-activate-delay:1750ms\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__stepAside\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__circle  \"><span class=\"ProcessTimeline-module-scss-module___J1vsW__number\">02</span></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__vLine \" aria-hidden=\"true\"></div></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__content\"><h3 class=\"ProcessTimeline-module-scss-module___J1vsW__stepTitle\">Design a Tailored Proposal</h3><p class=\"ProcessTimeline-module-scss-module___J1vsW__stepDescription\">A custom plan with transparent pricing and clear deliverables.</p></div></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__stepItem\" style=\"--activate-delay:1750ms;--vline-activate-delay:2450ms\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__stepAside\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__circle  \"><span class=\"ProcessTimeline-module-scss-module___J1vsW__number\">03</span></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__vLine \" aria-hidden=\"true\"></div></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__content\"><h3 class=\"ProcessTimeline-module-scss-module___J1vsW__stepTitle\">Venue &amp; Logistics Setup</h3><p class=\"ProcessTimeline-module-scss-module___J1vsW__stepDescription\">Complete event infrastructure and coordination</p></div></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__stepItem\" style=\"--activate-delay:2450ms;--vline-activate-delay:3150ms\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__stepAside\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__circle  \"><span class=\"ProcessTimeline-module-scss-module___J1vsW__number\">04</span></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__vLine \" aria-hidden=\"true\"></div></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__content\"><h3 class=\"ProcessTimeline-module-scss-module___J1vsW__stepTitle\">Execute &amp; Coordinate</h3><p class=\"ProcessTimeline-module-scss-module___J1vsW__stepDescription\">Seamless logistics, vendor management, and on-site support.</p></div></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__stepItem\" style=\"--activate-delay:3150ms\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__stepAside\"><div class=\"ProcessTimeline-module-scss-module___J1vsW__circle  \"><span class=\"ProcessTimeline-module-scss-module___J1vsW__number\">05</span></div></div><div class=\"ProcessTimeline-module-scss-module___J1vsW__content\"><h3 class=\"ProcessTimeline-module-scss-module___J1vsW__stepTitle\">Measurable Experience</h3><p class=\"ProcessTimeline-module-scss-module___J1vsW__stepDescription\">Post-event reporting and feedback to ensure continuous improvement.</p></div></div></div></div></section></div><section class=\"B2BStats-module-scss-module__lVYK6W__section\"><div class=\"B2BStats-module-scss-module__lVYK6W__decoration\" aria-hidden=\"true\"><img alt=\"\" loading=\"lazy\" width=\"355\" height=\"266\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/dotted-line3.svg\"/></div><div class=\"B2BStats-module-scss-module__lVYK6W__header\"><h2 class=\"B2BStats-module-scss-module__lVYK6W__title\">Why Us</h2><p class=\"B2BStats-module-scss-module__lVYK6W__subtitle\">TRUSTED BY LEADING ORGANIZATIONS</p></div><div class=\"B2BStats-module-scss-module__lVYK6W__statsWrapper\"><div class=\"B2BStats-module-scss-module__lVYK6W__statsGrid\"><div class=\"B2BStats-module-scss-module__lVYK6W__statItem\"><span class=\"B2BStats-module-scss-module__lVYK6W__value\">0+</span><span class=\"B2BStats-module-scss-module__lVYK6W__label\">Corporate Events</span></div><div class=\"B2BStats-module-scss-module__lVYK6W__statItem\"><span class=\"B2BStats-module-scss-module__lVYK6W__value\">+0</span><span class=\"B2BStats-module-scss-module__lVYK6W__label\">Client Satisfaction</span></div><div class=\"B2BStats-module-scss-module__lVYK6W__statItem\"><span class=\"B2BStats-module-scss-module__lVYK6W__value\">0%</span><span class=\"B2BStats-module-scss-module__lVYK6W__label\">Client Satisfaction Rate</span></div></div><div class=\"B2BStats-module-scss-module__lVYK6W__badgesCard\"><div class=\"B2BStats-module-scss-module__lVYK6W__badgesRow\"><div class=\"B2BStats-module-scss-module__lVYK6W__badge\"><div class=\"B2BStats-module-scss-module__lVYK6W__iconWrap\"><img alt=\"\" loading=\"lazy\" width=\"17\" height=\"16\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/star-blue.svg\"/></div><span class=\"B2BStats-module-scss-module__lVYK6W__badgeText\">Dedicated corporate account manager</span></div><div class=\"B2BStats-module-scss-module__lVYK6W__badge\"><div class=\"B2BStats-module-scss-module__lVYK6W__iconWrap\"><img alt=\"\" loading=\"lazy\" width=\"17\" height=\"16\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/star-blue.svg\"/></div><span class=\"B2BStats-module-scss-module__lVYK6W__badgeText\">5-Star hotel partnerships</span></div><div class=\"B2BStats-module-scss-module__lVYK6W__badge\"><div class=\"B2BStats-module-scss-module__lVYK6W__iconWrap\"><img alt=\"\" loading=\"lazy\" width=\"17\" height=\"16\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/star-blue.svg\"/></div><span class=\"B2BStats-module-scss-module__lVYK6W__badgeText\">Exclusive venue access</span></div><div class=\"B2BStats-module-scss-module__lVYK6W__badge\"><div class=\"B2BStats-module-scss-module__lVYK6W__iconWrap\"><img alt=\"\" loading=\"lazy\" width=\"17\" height=\"16\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/star-blue.svg\"/></div><span class=\"B2BStats-module-scss-module__lVYK6W__badgeText\">Full transportation &amp; logistics</span></div><div class=\"B2BStats-module-scss-module__lVYK6W__badge\"><div class=\"B2BStats-module-scss-module__lVYK6W__iconWrap\"><img alt=\"\" loading=\"lazy\" width=\"17\" height=\"16\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/star-blue.svg\"/></div><span class=\"B2BStats-module-scss-module__lVYK6W__badgeText\">Transparent contracts</span></div></div><div class=\"B2BStats-module-scss-module__lVYK6W__badgesRow\"><div class=\"B2BStats-module-scss-module__lVYK6W__badge\"><div class=\"B2BStats-module-scss-module__lVYK6W__iconWrap\"><img alt=\"\" loading=\"lazy\" width=\"17\" height=\"16\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/star-blue.svg\"/></div><span class=\"B2BStats-module-scss-module__lVYK6W__badgeText\">Multilingual team</span></div><div class=\"B2BStats-module-scss-module__lVYK6W__badge\"><div class=\"B2BStats-module-scss-module__lVYK6W__iconWrap\"><img alt=\"\" loading=\"lazy\" width=\"17\" height=\"16\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/star-blue.svg\"/></div><span class=\"B2BStats-module-scss-module__lVYK6W__badgeText\">24/7 operational support</span></div></div></div></div></section><div class=\"B2BProgramsPage-module-scss-module__Q8r_PW__container\"><section class=\"B2BTestimonials-module-scss-module__tKK_UG__section\"><div class=\"B2BTestimonials-module-scss-module__tKK_UG__header\"><h2 class=\"B2BTestimonials-module-scss-module__tKK_UG__title\">What Our Corporate Partners Say</h2><p class=\"B2BTestimonials-module-scss-module__tKK_UG__subtitle\">Hear from organizations that partnered with us for high-impact corporate.</p></div><div class=\"ReviewGrid-module-scss-module__FsDWRq__reviewsWrap\"><div class=\"ReviewGrid-module-scss-module__FsDWRq__grid B2BTestimonials-module-scss-module__tKK_UG__grid\"><div class=\"TestimonialCard-module-scss-module__YyZYmG__card\"><div class=\"TestimonialCard-module-scss-module__YyZYmG__videoWrapper\"><div class=\"TestimonialCard-module-scss-module__YyZYmG__videoThumb\"><img alt=\"Marcus Chen\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"TestimonialCard-module-scss-module__YyZYmG__thumbImg\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, 280px\" srcSet=\"/_next/image?url=%2Fimages%2Ftestimonials%2Fmarcus.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Ftestimonials%2Fmarcus.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Ftestimonials%2Fmarcus.jpg&amp;w=828&amp;q=75 828w, /_next/