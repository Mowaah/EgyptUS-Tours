parent\" src=\"/images/clock.svg\"/>21 July 2026</span></div></article><article class=\"BlogCard-module-scss-module__51QHiq__card\"><div class=\"BlogCard-module-scss-module__51QHiq__imageWrap\"><img alt=\"Hidden Gems of Alexandria: Beyond the Library\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"BlogCard-module-scss-module__51QHiq__image\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=3840&amp;q=75\"/></div><div class=\"BlogCard-module-scss-module__51QHiq__body\"><span class=\"BlogCard-module-scss-module__51QHiq__category BlogCard-module-scss-module__51QHiq__blue\">Destinations</span><h3 class=\"BlogCard-module-scss-module__51QHiq__title\">Hidden Gems of Alexandria: Beyond the Library</h3><p class=\"BlogCard-module-scss-module__51QHiq__excerpt\">Skip the heavy crowds and explore the coastal ruins and underground catacombs of the old Greek capital.</p></div><div class=\"BlogCard-module-scss-module__51QHiq__footer\"><a class=\"BlogCard-module-scss-module__51QHiq__read\" href=\"/blogs/5\">Read blog<img alt=\"\" loading=\"lazy\" width=\"14\" height=\"14\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/arrows/arrow-right-blue3.svg\"/></a><span class=\"BlogCard-module-scss-module__51QHiq__date\"><img alt=\"Date\" loading=\"lazy\" width=\"14\" height=\"14\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/clock.svg\"/>08 August 2026</span></div></article><article class=\"BlogCard-module-scss-module__51QHiq__card\"><div class=\"BlogCard-module-scss-module__51QHiq__imageWrap\"><img alt=\"The Ultimate Guide to Luxor&#x27;s 5-Star River Cruises\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"BlogCard-module-scss-module__51QHiq__image\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fhome%2Fhero-bg.png&amp;w=3840&amp;q=75\"/></div><div class=\"BlogCard-module-scss-module__51QHiq__body\"><span class=\"BlogCard-module-scss-module__51QHiq__category BlogCard-module-scss-module__51QHiq__orange\">Luxury</span><h3 class=\"BlogCard-module-scss-module__51QHiq__title\">The Ultimate Guide to Luxor&#x27;s 5-Star River Cruises</h3><p class=\"BlogCard-module-scss-module__51QHiq__excerpt\">Watch the temples glide by from a rooftop pool deck. We review the best high-end vessels on the Nile.</p></div><div class=\"BlogCard-module-scss-module__51QHiq__footer\"><a class=\"BlogCard-module-scss-module__51QHiq__read\" href=\"/blogs/6\">Read blog<img alt=\"\" loading=\"lazy\" width=\"14\" height=\"14\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/arrows/arrow-right-blue3.svg\"/></a><span class=\"BlogCard-module-scss-module__51QHiq__date\"><img alt=\"Date\" loading=\"lazy\" width=\"14\" height=\"14\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/clock.svg\"/>29 September 2026</span></div></article></div><div class=\"BlogTrending-module-scss-module__3bXc5q__paginationWrapper\"><div class=\"Pagination-module-scss-module__DAodxW__root\"><button class=\"Pagination-module-scss-module__DAodxW__arrow Pagination-module-scss-module__DAodxW__prevArrow\" disabled=\"\" aria-label=\"Previous page\"><img alt=\"\" loading=\"lazy\" width=\"15\" height=\"15\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/arrows/pagination-arrow.svg\"/></button><div class=\"Pagination-module-scss-module__DAodxW__pages\"><button class=\"Pagination-module-scss-module__DAodxW__pageBtn Pagination-module-scss-module__DAodxW__active \" aria-current=\"page\">1</button><button class=\"Pagination-module-scss-module__DAodxW__pageBtn  \">2</button><button class=\"Pagination-module-scss-module__DAodxW__pageBtn  \">3</button><button class=\"Pagination-module-scss-module__DAodxW__pageBtn  Pagination-module-scss-module__DAodxW__dots\" disabled=\"\">...</button><button class=\"Pagination-module-scss-module__DAodxW__pageBtn  \">13</button><button class=\"Pagination-module-scss-module__DAodxW__pageBtn  \">14</button><button class=\"Pagination-module-scss-module__DAodxW__pageBtn  \">15</button></div><button class=\"Pagination-module-scss-module__DAodxW__arrow Pagination-module-scss-module__DAodxW__nextArrow\" aria-label=\"Next page\"><img alt=\"\" loading=\"lazy\" width=\"15\" height=\"15\" decoding=\"async\" data-nimg=\"1\" style=\"color:transparent\" src=\"/images/arrows/pagination-arrow-white.svg\"/></button></div></div></div></section></div><section class=\"FaqSection-module-scss-module__gCZMsW__section \"><div class=\"FaqSection-module-scss-module__gCZMsW__container\"><div class=\"SectionHeader-module-scss-module__J6xJhW__header SectionHeader-module-scss-module__J6xJhW__center\" style=\"max-width:500px\"><span class=\"SectionHeader-module-scss-module__J6xJhW__label\"><img alt=\"Trips\" loading=\"lazy\" width=\"18\" height=\"18\" decoding=\"async\" data-nimg=\"1\" class=\"SectionHeader-module-scss-module__J6xJhW__labelIcon\" style=\"color:transparent\" src=\"/images/trips2.svg\"/>Frequently Asked Questions</span><h2 class=\"SectionHeader-module-scss-module__J6xJhW__heading SectionHeader-module-scss-module__J6xJhW__headingLarge \">Got questions?</h2><p class=\"SectionHeader-module-scss-module__J6xJhW__description\">Find quick answers about booking, pricing and transportation details.</p></div><div class=\"FaqSection-module-scss-module__gCZMsW__accordion\"><div class=\"FaqSection-module-scss-module__gCZMsW__item FaqSection-module-scss-module__gCZMsW__open\"><button class=\"FaqSection-module-scss-module__gCZMsW__question\" aria-expanded=\"true\"><span class=\"FaqSection-module-scss-module__gCZMsW__number\">01</span><span class=\"FaqSection-module-scss-module__gCZMsW__questionText\">Why should I book with Egypt Us ?</span><span class=\"FaqSection-module-scss-module__gCZMsW__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 9 5\" class=\"FaqSection-module-scss-module__gCZMsW__chevron FaqSection-module-scss-module__gCZMsW__chevronOpen\"><path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.167\" d=\"m7.584.584-3.5 3.5-3.5-3.5\"></path></svg></span></button><div class=\"FaqSection-module-scss-module__gCZMsW__answer\"><p>Booking with Egypt Us means choosing experience, reliability, and personalized service. Our travel experts create well-planned itineraries, supported by licensed local guides, high-quality partners, and 24/7 customer support. Every detail is carefully managed to ensure a smooth, authentic, and memorable travel experience.</p></div></div><div class=\"FaqSection-module-scss-module__gCZMsW__item \"><button class=\"FaqSection-module-scss-module__gCZMsW__question\" aria-expanded=\"false\"><span class=\"FaqSection-module-scss-module__gCZMsW__number\">02</span><span class=\"FaqSection-module-scss-module__gCZMsW__questionText\">Can I customize my itinerary to match my interests and budget?</span><span class=\"FaqSection-module-scss-module__gCZMsW__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 9 5\" class=\"FaqSection-module-scss-module__gCZMsW__chevron \"><path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.167\" d=\"m7.584.584-3.5 3.5-3.5-3.5\"></path></svg></span></button></div><div class=\"FaqSection-module-scss-module__gCZMsW__item \"><button class=\"FaqSection-module-scss-module__gCZMsW__question\" aria-expanded=\"false\"><span class=\"FaqSection-module-scss-module__gCZMsW__number\">03</span><span class=\"FaqSection-module-scss-module__gCZMsW__questionText\">What should I do if there&#x27;s an emergency during my trip?</span><span class=\"FaqSection-module-scss-module__gCZMsW__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 9 5\" class=\"FaqSection-module-scss-module__gCZMsW__chevron \"><path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.167\" d=\"m7.584.584-3.5 3.5-3.5-3.5\"></path></svg></span></button></div><div class=\"FaqSection-module-scss-module__gCZMsW__item \"><button class=\"FaqSection-module-scss-module__gCZMsW__question\" aria-expanded=\"false\"><span class=\"FaqSection-module-scss-module__gCZMsW__number\">04</span><span class=\"FaqSection-module-scss-module__gCZMsW__questionText\">What happens if I need to cancel my reservation with Egypt Us ?</span><span class=\"FaqSection-module-scss-module__gCZMsW__icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 9 5\" class=\"FaqSection-module-scss-module__gCZMsW__chevron \"><path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.167\" d=\"m7.584.584-3.5 3.5-3.5-3.5\"></path></svg></span></button></div></div></div></section><section class=\"BlogSubscribe-module-scss-module__iQfZ8G__section\"><div class=\"BlogSubscribe-module-scss-module__iQfZ8G__planeDecoration\"><img alt=\"\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"BlogSubscribe-module-scss-module__iQfZ8G__planeImage\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/paper-plane.svg\"/></div><div class=\"BlogSubscribe-module-scss-module__iQfZ8G__contentBlock\"><h2 class=\"BlogSubscribe-module-scss-module__iQfZ8G__title\">Subscribe Now For Egypt US Latest Blogs !</h2><div class=\"BlogSubscribe-module-scss-module__iQfZ8G__formGroup\"><div class=\"BlogSubscribe-module-scss-module__iQfZ8G__inputWrap\"><input type=\"email\" placeholder=\"Youremail@Gmail.Com\" class=\"BlogSubscribe-module-scss-module__iQfZ8G__input\" required=\"\"/></div><button type=\"submit\" class=\"BlogSubscribe-module-scss-module__iQfZ8G__button\">Subscribe</button></div></div></section></main><!--$--><!--/$--></main><div class=\"ChatBot-module-scss-module__SK1QVq__chatbotContainer \" data-chatbot-root=\"true\"><button class=\"ChatBot-module-scss-module__SK1QVq__trigger\" aria-label=\"Open chat\"><img alt=\"Chat Bot\" draggable=\"false\" loading=\"lazy\" width=\"77.5\" height=\"77.5\" decoding=\"async\" data-nimg=\"1\" class=\"ChatBot-module-scss-module__SK1QVq__triggerIcon\" style=\"color:transparent\" src=\"/images/robot.svg\"/></button></div><footer class=\"Footer-module-scss-module__r8i0SG__footer\"><div class=\"Footer-module-scss-module__r8i0SG__container\"><div class=\"Footer-module-scss-module__r8i0SG__top\"><div class=\"Footer-module-scss-module__r8i0SG__brand\"><a class=\"Footer-module-scss-module__r8i0SG__logoLink\" href=\"/\"><img alt=\"Logo\" loading=\"lazy\" width=\"150\" height=\"30\" decoding=\"async\